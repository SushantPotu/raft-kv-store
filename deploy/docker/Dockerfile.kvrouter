# Placeholder until Workstream H lands cmd/kvrouter/main.go.
FROM golang:1.23 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/kvrouter ./cmd/kvrouter

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/kvrouter /kvrouter
EXPOSE 9100
ENTRYPOINT ["/kvrouter"]
