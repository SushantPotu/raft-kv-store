# cmd/kvrouter/main.go: the stateless Multi-Raft router (see
# internal/routing). Base image matches Dockerfile.kvnode's golang:1.25 —
# go.mod's `go 1.25.0` directive requires a newer toolchain than
# golang:1.23 (this file's original placeholder) ships.
FROM golang:1.25 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/kvrouter ./cmd/kvrouter

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/kvrouter /kvrouter
EXPOSE 9100
ENTRYPOINT ["/kvrouter"]
