# Placeholder until Workstream H lands cmd/metaservice/main.go.
FROM golang:1.23 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/metaservice ./cmd/metaservice

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/metaservice /metaservice
EXPOSE 9200
ENTRYPOINT ["/metaservice"]
